#!/usr/bin/env bash
# pre-commit: fast pack gates — Layer-A lint + certification freshness (PM-10).
# Install once per clone: ./scripts/hooks/install.sh
# Bypass one commit:     git commit --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ "${SKIP_HOOKS:-0}" == "1" ]]; then
  echo "pre-commit: SKIP_HOOKS=1 — skipping."
  exit 0
fi

# True for question-packs/<course>/<pack>.json installable by build_manifest.
is_installable_pack() {
  local relpath="$1"
  local course file
  [[ "$relpath" =~ ^question-packs/([^/]+)/([^/]+\.json)$ ]] || return 1
  course="${BASH_REMATCH[1]}"
  file="${BASH_REMATCH[2]}"
  [[ "$course" == .* || "$course" == _* ]] && return 1
  [[ "$course" == zz-hooktest-* ]] && return 1
  case "$file" in
    _course.json | manifest.json | manifest.example.json) return 1 ;;
  esac
  return 0
}

staged_packs=()
while IFS= read -r path; do
  [[ -z "$path" ]] && continue
  is_installable_pack "$path" || continue
  staged_packs+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -- 'question-packs/' || true)

if ((${#staged_packs[@]} == 0)); then
  exit 0
fi

echo "pre-commit: linting ${#staged_packs[@]} staged pack(s)"
if ! python3 scripts/lint_packs.py "${staged_packs[@]}"; then
  echo "pre-commit: lint failed — fix critical/warning findings (or waive with lint_waivers)." >&2
  exit 1
fi

for pack in "${staged_packs[@]}"; do
  if ! python3 - "$pack" <<'PY'
import json
import sys
from pathlib import Path

sys.path.insert(0, "scripts")
from pack_cert import certification_fresh, has_pack_wide_l23_waiver

pack_path = Path(sys.argv[1])
try:
    data = json.loads(pack_path.read_text())
except (OSError, json.JSONDecodeError) as exc:
    print(f"error: {pack_path}: could not load pack JSON ({exc})", file=sys.stderr)
    raise SystemExit(1)

if not isinstance(data, dict):
    print(f"error: {pack_path}: pack root must be a JSON object", file=sys.stderr)
    raise SystemExit(1)

if has_pack_wide_l23_waiver(data):
    print(
        f"error: {pack_path}: pack-wide L23 lint_waiver is not allowed on installed packs (PM-5).\n"
        "Remove the pack-wide L23 waiver (or scope it to a specific qid).",
        file=sys.stderr,
    )
    raise SystemExit(1)

if not certification_fresh(data):
    print(
        f"error: {pack_path}: certification is missing or stale (PM-10).\n"
        "Installed packs must carry a fresh certification block after verify_pack.\n"
        "Re-run: python3 scripts/verify_pack.py "
        f"{pack_path}",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
  then
    exit 1
  fi
done

echo "pre-commit: OK (${#staged_packs[@]} pack(s))"
