#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
[[ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" == "$ROOT" ]] || {
  echo "release-testflight: checkout root could not be verified" >&2
  exit 4
}

CENTRAL_ROOT="$ROOT/../apple_developer"
ADAPTER="$ROOT/.release/release-adapter.json"
if [[ -x "${HOME:-}/.agent/bin/bws-secret-exec" ]]; then
  PATH="$HOME/.agent/bin:$PATH"
  export PATH
fi
[[ -f "$CENTRAL_ROOT/release_tools/__main__.py" && -f "$ADAPTER" ]] || {
  echo "release-testflight: central release_tools or adapter is unavailable" >&2
  exit 4
}
for arg in "$@"; do
  case "$arg" in
    --adapter|--adapter=*|--repository|--repository=*|--broker|--broker=*|--executable|--executable=*|--credential|--credential=*|--upload)
      echo "release-testflight: caller-selected paths, credentials, and upload are not permitted; this adapter declares no upload operation (see .release/release-plan.json manualBoundaries)" >&2
      exit 2
      ;;
  esac
done
# release_tools declares requires-python = ">=3.11".  Xcode's /usr/bin/python3
# is 3.9 and fails at import, so select a fixed absolute Homebrew interpreter
# that clears the floor; hooks and launchd run with a minimal PATH.
PYTHON_MINIMUM_MAJOR=3
PYTHON_MINIMUM_MINOR=11
PYTHON_BIN=""
for candidate_interpreter in /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  [[ -x "$candidate_interpreter" ]] || continue
  if "$candidate_interpreter" -c \
    "import sys; raise SystemExit(0 if sys.version_info[:2] >= ($PYTHON_MINIMUM_MAJOR, $PYTHON_MINIMUM_MINOR) else 1)" \
    >/dev/null 2>&1; then
    PYTHON_BIN="$candidate_interpreter"
    break
  fi
done
[[ -n "$PYTHON_BIN" ]] || {
  echo "release-testflight: no python3 >= ${PYTHON_MINIMUM_MAJOR}.${PYTHON_MINIMUM_MINOR} is available for release_tools" >&2
  exit 4
}
# PYTHONSAFEPATH=1: "python -m" puts the working directory at sys.path[0],
# ahead of PYTHONPATH, so a release_tools/ directory in the caller's cwd
# would shadow the central framework.  Requires Python >= 3.11, enforced above.
exec env PYTHONSAFEPATH=1 PYTHONPATH="$CENTRAL_ROOT" "$PYTHON_BIN" -m release_tools testflight \
  --adapter "$ADAPTER" --repository "$ROOT" "$@"
