#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 1 && "$1" == "--attended" ]] || {
  echo "deploy-testflight: explicit --attended invocation is required" >&2
  exit 64
}

if [[ "${QUIZZLER_TESTFLIGHT_BWS_CONSUMER:-}" != "quizzler-testflight-upload" ]]; then
  exec /opt/homebrew/bin/python3 "${HOME:?}/Documents/Projects/bws/bws-secret-exec.py" \
    quizzler-testflight-upload -- --attended
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
CENTRAL_ROOT="$ROOT/../apple_developer"
ADAPTER="$ROOT/.release/release-adapter.json"
[[ -f "$CENTRAL_ROOT/release_tools/__main__.py" && -f "$ADAPTER" ]] || {
  echo "deploy-testflight: central release_tools or adapter is unavailable" >&2
  exit 69
}
exec env PYTHONPATH="$CENTRAL_ROOT" /usr/bin/python3 -m release_tools testflight \
  --adapter "$ADAPTER" --repository "$ROOT"
