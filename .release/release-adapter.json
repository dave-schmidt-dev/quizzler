{
  "schemaVersion": "1.0.0",
  "workflow": {
    "coreVersion": "1.0.0",
    "profile": "appleTestFlightV2",
    "profileVersion": "2.0.0"
  },
  "product": {
    "productKey": "quizzler-ios",
    "platform": "ios",
    "bundleIdentifier": "com.zerodelta.quizzler",
    "teamIdentifier": "4CJ49V6QHW"
  },
  "state": {
    "formatVersion": 3,
    "nonGitCanonicalHome": ".release-state"
  },
  "sourcePaths": [
    "app/QuizzleriOS",
    "app/QuizzlerKit/Sources",
    "app/Quizzler.xcodeproj",
    "app/project.yml",
    "scripts/build_pack_assets.py",
    "question-packs"
  ],
  "nonSourcePaths": [
    "question-packs/_archive",
    "question-packs/_staging",
    "question-packs/_samples_backup_test"
  ],
  "environmentInputs": [],
  "registeredConsumers": [
    {
      "name": "quizzler-testflight-upload",
      "evidence": {
        "formatVersion": "1.0.0",
        "consumer": "quizzler-testflight-upload",
        "descriptorSha256": "f032feec6213e25679aaf9fbfea55ce5606ea4da9f5573dfc2e6b88988fb068f",
        "brokerContractVersion": "1.0.0"
      }
    }
  ],
  "operations": [
    {
      "id": "source-snapshot",
      "class": "sourceSnapshot",
      "mode": "framework",
      "proofSchema": "release.proof.source-snapshot.v1",
      "dependencies": [],
      "timeoutSeconds": 120,
      "statusEvents": {
        "started": "source-snapshot:started",
        "heartbeat": "source-snapshot:heartbeat",
        "succeeded": "source-snapshot:succeeded",
        "failed": "source-snapshot:failed",
        "blocked": "source-snapshot:blocked"
      }
    },
    {
      "id": "readiness",
      "class": "readiness",
      "mode": "nonCredential",
      "argv": [
        "python3",
        "app/scripts/release_readiness.py",
        "--candidate",
        "current"
      ],
      "workingDirectory": ".",
      "environment": {
        "inherit": false,
        "inputs": [],
        "literals": {}
      },
      "proofSchema": "release.proof.readiness.v1",
      "dependencies": [
        "source-snapshot"
      ],
      "timeoutSeconds": 120,
      "statusEvents": {
        "started": "readiness:started",
        "heartbeat": "readiness:heartbeat",
        "succeeded": "readiness:succeeded",
        "failed": "readiness:failed",
        "blocked": "readiness:blocked"
      }
    },
    {
      "id": "local-gate",
      "class": "localGate",
      "mode": "nonCredential",
      "argv": [
        "bash",
        "app/test-gate.sh"
      ],
      "workingDirectory": ".",
      "environment": {
        "inherit": false,
        "inputs": [],
        "literals": {}
      },
      "proofSchema": "release.proof.local-gate.v1",
      "dependencies": [
        "readiness"
      ],
      "timeoutSeconds": 3600,
      "statusEvents": {
        "started": "local-gate:started",
        "heartbeat": "local-gate:heartbeat",
        "succeeded": "local-gate:succeeded",
        "failed": "local-gate:failed",
        "blocked": "local-gate:blocked"
      }
    },
    {
      "id": "production-build",
      "class": "productionReleaseBuild",
      "mode": "nonCredential",
      "argv": [
        "python3",
        "app/scripts/prepare_testflight_candidate.py"
      ],
      "workingDirectory": ".",
      "environment": {
        "inherit": false,
        "inputs": [],
        "literals": {}
      },
      "proofSchema": "release.proof.production-build.v1",
      "dependencies": [
        "local-gate"
      ],
      "timeoutSeconds": 600,
      "statusEvents": {
        "started": "production-build:started",
        "heartbeat": "production-build:heartbeat",
        "succeeded": "production-build:succeeded",
        "failed": "production-build:failed",
        "blocked": "production-build:blocked"
      }
    },
    {
      "id": "archive",
      "class": "archive",
      "mode": "nonCredential",
      "argv": [
        "python3",
        "app/scripts/prepare_testflight_candidate.py"
      ],
      "workingDirectory": ".",
      "environment": {
        "inherit": false,
        "inputs": [],
        "literals": {}
      },
      "proofSchema": "release.proof.archive.v1",
      "dependencies": [
        "production-build"
      ],
      "timeoutSeconds": 600,
      "statusEvents": {
        "started": "archive:started",
        "heartbeat": "archive:heartbeat",
        "succeeded": "archive:succeeded",
        "failed": "archive:failed",
        "blocked": "archive:blocked"
      }
    },
    {
      "id": "sign",
      "class": "sign",
      "mode": "nonCredential",
      "argv": [
        "python3",
        "app/scripts/provision_signing.py",
        "--dry-run"
      ],
      "workingDirectory": ".",
      "environment": {
        "inherit": false,
        "inputs": [],
        "literals": {}
      },
      "proofSchema": "release.proof.signing.v1",
      "dependencies": [
        "archive"
      ],
      "timeoutSeconds": 600,
      "statusEvents": {
        "started": "sign:started",
        "heartbeat": "sign:heartbeat",
        "succeeded": "sign:succeeded",
        "failed": "sign:failed",
        "blocked": "sign:blocked"
      }
    },
    {
      "id": "artifact-verify",
      "class": "artifactVerify",
      "mode": "nonCredential",
      "argv": [
        "python3",
        "app/scripts/device_acceptance.py",
        "--candidate",
        "current",
        "--verify-only"
      ],
      "workingDirectory": ".",
      "environment": {
        "inherit": false,
        "inputs": [],
        "literals": {}
      },
      "proofSchema": "release.proof.artifact.v1",
      "dependencies": [
        "sign"
      ],
      "timeoutSeconds": 600,
      "statusEvents": {
        "started": "artifact-verify:started",
        "heartbeat": "artifact-verify:heartbeat",
        "succeeded": "artifact-verify:succeeded",
        "failed": "artifact-verify:failed",
        "blocked": "artifact-verify:blocked"
      }
    },
    {
      "id": "device-health",
      "class": "deviceHealth",
      "mode": "nonCredential",
      "argv": [
        "python3",
        "app/scripts/reconcile_production.py",
        "--candidate",
        "current",
        "--evidence",
        "app/release-device-evidence.example.json"
      ],
      "workingDirectory": ".",
      "environment": {
        "inherit": false,
        "inputs": [],
        "literals": {}
      },
      "proofSchema": "release.proof.device-health.v1",
      "dependencies": [
        "artifact-verify"
      ],
      "timeoutSeconds": 600,
      "statusEvents": {
        "started": "device-health:started",
        "heartbeat": "device-health:heartbeat",
        "succeeded": "device-health:succeeded",
        "failed": "device-health:failed",
        "blocked": "device-health:blocked"
      }
    },
    {
      "id": "receipt",
      "class": "receipt",
      "mode": "framework",
      "proofSchema": "release.proof.receipt.v1",
      "dependencies": [
        "device-health"
      ],
      "timeoutSeconds": 120,
      "statusEvents": {
        "started": "receipt:started",
        "heartbeat": "receipt:heartbeat",
        "succeeded": "receipt:succeeded",
        "failed": "receipt:failed",
        "blocked": "receipt:blocked"
      }
    }
  ],
  "evidencePaths": [
    {
      "name": "candidate-proof",
      "path": ".release-state/evidence/{candidateId}/candidate.json",
      "contentType": "application/json"
    },
    {
      "name": "readiness-proof",
      "path": ".release-state/evidence/{candidateId}/readiness.json",
      "contentType": "application/json"
    },
    {
      "name": "local-gate-proof",
      "path": ".release-state/evidence/{candidateId}/local-gate.json",
      "contentType": "application/json"
    },
    {
      "name": "production-build-proof",
      "path": ".release-state/evidence/{candidateId}/production-build.json",
      "contentType": "application/json"
    },
    {
      "name": "archive-proof",
      "path": ".release-state/evidence/{candidateId}/archive.json",
      "contentType": "application/json"
    },
    {
      "name": "signing-proof",
      "path": ".release-state/evidence/{candidateId}/signing.json",
      "contentType": "application/json"
    },
    {
      "name": "artifact-proof",
      "path": ".release-state/evidence/{candidateId}/artifact.json",
      "contentType": "application/json"
    },
    {
      "name": "device-health-proof",
      "path": ".release-state/evidence/{candidateId}/device-health.json",
      "contentType": "application/json"
    },
    {
      "name": "receipt-proof",
      "path": ".release-state/evidence/{candidateId}/receipt.json",
      "contentType": "application/json"
    }
  ],
  "localSmoke": false
}
